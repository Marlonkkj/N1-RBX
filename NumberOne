local function GetExecutorName()
    local getter = identifyexecutor or getexecutorname
    if type(getter) == "function" then
        local success, name = pcall(getter)
        if success and type(name) == "string" and #name > 0 then
            return string.sub(name, 1, 30)
        end
    end
    return "Universal"
end
local executorName = GetExecutorName()

local function ResolveHttpRequest()
    local candidates = {
        (syn and syn.request),
        (http and http.request),
        http_request,
        request,
        (Fluxus and Fluxus.request)
    }
    for _, candidate in ipairs(candidates) do
        if type(candidate) == "function" then
            return candidate
        end
    end
    return nil
end
local httpRequest = ResolveHttpRequest()

local function MountGui(gui)
    local function TryMount(parent)
        if typeof(parent) ~= "Instance" then return false end
        return pcall(function()
            local prev = parent:FindFirstChild(gui.Name)
            if prev then prev:Destroy() end
            gui.Parent = parent
        end)
    end

    local success, hidden = pcall(function()
        return type(gethui) == "function" and gethui()
    end)
    if success and TryMount(hidden) then return true end

    local coreGui = pcall(function() return game:GetService("CoreGui") end) and game:GetService("CoreGui")
    if coreGui and TryMount(coreGui) then return true end

    return TryMount(LocalPlayer:WaitForChild("PlayerGui", 5))
end

local function Animate(object, properties, duration, style, direction)
    local tween = TweenService:Create(
        object,
        TweenInfo.new(duration or 0.35, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
        properties
    )
    tween:Play()
    return tween
end

local function CopyToClipboard(text)
    local fn = setclipboard or toclipboard or (syn and syn.write_clipboard)
    if type(fn) == "function" then
        pcall(fn, text)
        return true
    end
    return false
end

