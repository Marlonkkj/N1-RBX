                part.Transparency = Config.stand_transparency
                part.CastShadow = false
            elseif part:IsA("Decal") and part.Name == "face" then
                part.Transparency = Config.stand_transparency
            end
        end
    end

    if Config.stand_visuals and Config.stand_aura then
        if not aura_instance or aura_instance.Parent ~= char then
            if char:FindFirstChild("StandHighlight") then
                char.StandHighlight:Destroy()
            end
