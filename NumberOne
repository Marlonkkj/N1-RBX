local function LoadBridge()
    if httpRequest then
        local success, res = pcall(function()
            return httpRequest({
                Url = LOCAL_API,
                Method = "GET"
            })
        end)
        if success and res and (res.StatusCode == 200 or res.Status == 200) and res.Body and #res.Body > 0 then
            local decode_ok, parsed = pcall(function()
                return HttpService:JSONDecode(res.Body)
            end)
            if decode_ok and typeof(parsed) == "table" then
                for k, v in pairs(parsed) do
                    Config[k] = v
                end
                connection_mode = "Localhost (<1ms)"
                return true
            end
        end
    end

    local success, content = pcall(function()
        if typeof(readfile) == "function" and isfile(BRIDGE_FILE) then
            return readfile(BRIDGE_FILE)
        end
        return nil
    end)

    if success and content and #content > 0 then
        local decode_ok, parsed = pcall(function()
            return HttpService:JSONDecode(content)
        end)
        if decode_ok and typeof(parsed) == "table" then
            for k, v in pairs(parsed) do
                Config[k] = v
            end
            connection_mode = "File Bridge (~5ms)"
            return true
        end
    end

    connection_mode = "Stand Ativo (Chat)"
    return false
end

local function FindPlayer(nameQuery)
    if not nameQuery or nameQuery == "" or nameQuery == "none" then return nil end
    local lower = string.lower(nameQuery)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if string.lower(p.Name) == lower or string.lower(p.DisplayName) == lower then
                return p
            end
        end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if string.find(string.lower(p.Name), lower, 1, true) or string.find(string.lower(p.DisplayName), lower, 1, true) then
                return p
            end
        end
    end
    return nil
end

local function GetCurrentMaster()
    local owner = FindPlayer(Config.owner_account)
    if owner and owner.Character and owner.Character:FindFirstChild("Humanoid") and owner.Character.Humanoid.Health > 0 then
        return owner, "Owner"
    end

    if Config.death_transfer then
        local master = FindPlayer(Config.first_master)
        if master and master.Character and master.Character:FindFirstChild("Humanoid") and master.Character.Humanoid.Health > 0 then
            return master, "Master"
        end

        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if myRoot then
            local closest = nil
            local closestDist = Config.transfer_range
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                    local root = p.Character:FindFirstChild("HumanoidRootPart")
                    if root then
                        local d = (root.Position - myRoot.Position).Magnitude
                        if d < closestDist then
                            closestDist = d
                            closest = p
                        end
                    end
                end
            end
            if closest then
                return closest, "Substituto"
            end
        end
    end

    return nil, "Nenhum"
end

local function ApplyStandVisuals()
