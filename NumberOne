local function SuppressWalkingAnimations()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    if hum and hum:FindFirstChild("Animator") then
        for _, track in ipairs(hum.Animator:GetPlayingAnimationTracks()) do
            local name = track.Name:lower()
            if name:find("walk") or name:find("run") or name:find("fall") then
                track:Stop(0.1)
            end
        end
    end
end

