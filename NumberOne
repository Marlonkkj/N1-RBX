local function TriggerAttack(targetRoot)
    local now = tick()
    if now - last_attack_time < Config.attack_gap then return end
    last_attack_time = now

    if Config.auto_stance then
        EnsureCombatStance()
    end

    if Config.attack_mode == "Heavy" then
        TriggerHeavy()
        return
    end

    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.wait(0.015)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end)

    if Config.m1_sfx and (now - last_sfx_time > Config.m1_sfx_gap) then
        last_sfx_time = now
        pcall(function()
            local sound = Instance.new("Sound")
            sound.SoundId = "rbxassetid://4590668852"
            sound.Volume = 0.5
            sound.Parent = workspace
            sound:Play()
            Debris:AddItem(sound, 1)
        end)
    end
end

local function FindTargetBall()
    local ballsFolder = workspace:FindFirstChild("Balls") or workspace:FindFirstChild("BallsFolder")
    local candidates = {}

    if ballsFolder then
        for _, b in ipairs(ballsFolder:GetChildren()) do
            if b:IsA("BasePart") or b:FindFirstChildWhichIsA("BasePart") then
                table.insert(candidates, b:IsA("BasePart") and b or b:FindFirstChildWhichIsA("BasePart"))
            end
        end
    end

    for _, obj in ipairs(workspace:GetChildren()) do
        if obj.Name:lower():find("ball") and (obj:IsA("BasePart") or obj:IsA("Model")) then
            local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
            if part then table.insert(candidates, part) end
        end
    end

    local myChar = LocalPlayer.Character
    if not myChar then return nil end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    local closestBall = nil
    local minD = 99999
    for _, b in ipairs(candidates) do
        local d = (b.Position - myRoot.Position).Magnitude
        if d < minD then
            minD = d
            closestBall = b
        end
    end
    return closestBall, minD
end

local function ExecuteChatCommand(sender, message)
    if not Config.chat_commands then return end
    local master, _ = GetCurrentMaster()

    local isAuthorized = (sender == master)
    if not isAuthorized and Config.owner_account and Config.owner_account ~= "none" then
        if sender.Name:lower() == Config.owner_account:lower() or sender.DisplayName:lower() == Config.owner_account:lower() then
            isAuthorized = true
        end
    end
    if not isAuthorized then return end

    local prefix = Config.chat_prefix
    local startsWithPrefix = (string.sub(message, 1, #prefix) == prefix)
    local startsWithExcl = (string.sub(message, 1, 1) == "!")
    local startsWithSemi = (string.sub(message, 1, 1) == ";")

    if not (startsWithPrefix or startsWithExcl or startsWithSemi) then return end

    local cleanMsg = message
    if startsWithPrefix then
        cleanMsg = string.sub(message, #prefix + 1)
    else
        cleanMsg = string.sub(message, 2)
    end

    local args = string.split(cleanMsg, " ")
    local cmd = string.lower(args[1] or "")
    local arg1 = args[2] or ""
    local arg2 = args[3] or ""

    if cmd == "stand" then
        if arg1 == "off" or arg1 == "false" then
            Config.enabled = false
        else
            Config.enabled = true
        end
    elseif cmd == "stay" or cmd == "hold" then
        Config.stand_mode = "Stay"
        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if myRoot then stay_cframe = myRoot.CFrame end
    elseif cmd == "follow" or cmd == "unstay" or cmd == "resume" then
        Config.stand_mode = "JoJo"
        if arg1 and arg1 ~= "" then
            Config.owner_account = arg1
        end
    elseif cmd == "owner" or cmd == "master" then
        if arg1 and arg1 ~= "" then
            Config.owner_account = arg1
        end
    elseif cmd == "bring" or cmd == "tp" then
        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local mRoot = sender.Character and sender.Character:FindFirstChild("HumanoidRootPart")
        if myRoot and mRoot then
            myRoot.CFrame = mRoot.CFrame * CFrame.new(Config.stand_offset_x, Config.stand_offset_y, Config.stand_offset_z)
        end
    elseif cmd == "attack" or cmd == "rush" or cmd == "kill" or cmd == "target" then
        Config.auto_attack = true
        if arg1 and arg1 ~= "" then
            Config.target_player = arg1
        else
            Config.auto_target = true
        end
    elseif cmd == "stop" or cmd == "idle" then
        Config.auto_attack = false
        Config.target_player = ""
        active_target_character = nil
    elseif cmd == "parry" then
        if arg1 == "off" then Config.auto_parry = false else Config.auto_parry = true end
    elseif cmd == "mimic" then
        if arg1 == "off" then Config.mimic_master = false else Config.mimic_master = true end
    elseif cmd == "mode" then
        if arg1:lower() == "jojo" then Config.stand_mode = "JoJo"
        elseif arg1:lower() == "back" then Config.stand_mode = "Back"
        elseif arg1:lower() == "front" then Config.stand_mode = "Front"
        elseif arg1:lower() == "orbit" then Config.stand_mode = "Orbit"
        end
    elseif cmd == "aura" or cmd == "color" then
        local colorName = arg1:lower()
        if COLOR_PRESETS[colorName] then
            Config.aura_color = COLOR_PRESETS[colorName]
            Config.aura_outline = Color3.new(
                math.clamp(Config.aura_color.R + 0.3, 0, 1),
                math.clamp(Config.aura_color.G + 0.3, 0, 1),
                math.clamp(Config.aura_color.B + 0.3, 0, 1)
            )
        end
    elseif cmd == "stance" then
        EnsureCombatStance()
    elseif cmd == "heavy" or cmd == "guardbreak" then
        TriggerHeavy()
    elseif cmd == "dash" or cmd == "dodge" then
        TriggerDash()
    elseif cmd == "dist" then
        local num = tonumber(arg1)
        if num then Config.follow_distance = num end
    elseif cmd == "height" then
        local num = tonumber(arg1)
        if num then Config.stand_offset_y = num end
    elseif cmd == "copy" or cmd == "copyinfo" then
        local info = string.format("Master: %s | Mode: %s | Conn: %s | Dist: %.1f", Config.owner_account, Config.stand_mode, connection_mode, Config.follow_distance)
        CopyToClipboard(info)
    elseif cmd == "reset" then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.Health = 0
        end
    elseif cmd == "say" then
        table.remove(args, 1)
        local sayText = table.concat(args, " ")
        pcall(function()
            local chatEvents = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
            if chatEvents and chatEvents:FindFirstChild("SayMessageRequest") then
                chatEvents.SayMessageRequest:FireServer(sayText, "All")
            end
        end)
    end
end

